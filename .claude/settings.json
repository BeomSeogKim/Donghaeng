{
  "permissions": {
    "allow": [
      "Bash(gh pr merge*)",
      "Bash(./gradlew *)",
      "Bash(npm run *)",
      "Bash(npm ci*)",
      "Bash(npm test*)",
      "Bash(npx tsc*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch*)",
      "Bash(git restore *)",
      "Bash(git push*)",
      "Bash(gh issue *)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr list*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr comment*)",
      "Bash(gh run *)",
      "Bash(bash .claude/hooks/*)",
      "Bash(python3 design/components/build.py*)",
      "Bash(wc -l *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/merge-gate.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/db-guard.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/closes-guard.sh"
          }
        ]
      }
    ]
  }
}
