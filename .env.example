# List of environment variables this project needs (key names only, committed without values)
# Store the actual values in sealbox: printf '%s' "value" | sealbox set donghaeng/KEY_NAME
# Run with: sealbox run -p donghaeng -- CMD

# api/ — Postgres connection. Credentials are separate keys, never embedded in
# the URL: Hikari prints the jdbcUrl on a failed startup.
# Tests do not use these: they start their own Postgres via Testcontainers.
# DATABASE_URL=      # jdbc:postgresql://host:5432/donghaeng
# DB_USERNAME=
# DB_PASSWORD=
