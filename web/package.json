{
  "name": "donghaeng-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run check:tokens",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:design": "node scripts/check-design-values.mjs",
    "lint": "biome check --error-on-warnings . && npm run check:design",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
