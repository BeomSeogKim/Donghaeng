# Copy to .env.local (gitignored) only if you need to override the defaults.
# Nothing here is a secret — a bundled frontend has no secrets, since every
# value in it ships to the browser.

# Origin of the API. No trailing slash, and an exact origin: the server's CORS
# list has no wildcard.
#
# Unset, dev falls back to http://localhost:8080 (src/lib/api.ts) and a
# production build refuses to start rather than pointing at a laptop.
#
# Open the app itself at http://localhost:3000 — NOT 127.0.0.1, which is a
# different origin to the browser and is not on the server's list.
VITE_API_BASE_URL=http://localhost:8080
